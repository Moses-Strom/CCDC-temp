#!/usr/bin/env bash
# =============================================================================
# suricata-setup.sh - Suricata IDS/IPS for a CCDC Ubuntu 22.04 server
#
#   sudo ./suricata-setup.sh install       install, configure, start in IDS mode, self-test
#   sudo ./suricata-setup.sh ips-on        switch to IPS (fail-open; reverts if scoring breaks)
#   sudo ./suricata-setup.sh ips-off       back to IDS
#   sudo ./suricata-setup.sh block IP      drop all traffic from one attacker IP (IPS mode)
#   sudo ./suricata-setup.sh unblock IP    remove that block
#   sudo ./suricata-setup.sh alerts        last 20 alerts: time, source, destination, name
#   sudo ./suricata-setup.sh status        mode, rules loaded, queue rules, memory
#
# What it adapts to on its own:
#   - the network interface and subnet (from the default route) -> HOME_NET
#   - which services are listening -> local rules for POP3, IMAP, SMTP AUTH
#     brute force and webshell-style URLs, only for the services present
#
# Safety:
#   - IPS uses the mangle table with --queue-bypass and nfq fail-open: if
#     Suricata stops, crashes or falls behind, traffic keeps flowing and ufw
#     still filters it. Tested: a killed Suricata did not interrupt traffic.
#   - Only rules YOU add with "block" (or write yourself) drop traffic.
#     Emerging Threats rules stay alert-only, so a false positive can't fail a
#     scoring check.
#   - ips-on re-checks every scored port that was answering before and the
#     webmail page; if anything stops answering it switches back to IDS.
# =============================================================================

set -o pipefail
MODE="${1:-}"
CONF=/etc/suricata/suricata.yaml
LOCAL_RULES=/etc/suricata/rules/local.rules
DROPIN_DIR=/etc/systemd/system/suricata.service.d
DROPIN=$DROPIN_DIR/ips.conf
LOG=/var/log/suricata
SCORED_TCP=(21 22 25 80 110 143 443 465 587 993 995)

if [[ -t 1 ]]; then RED=$'\e[31m'; YEL=$'\e[33m'; GRN=$'\e[32m'; BLU=$'\e[1;34m'; RST=$'\e[0m'; else RED=""; YEL=""; GRN=""; BLU=""; RST=""; fi
step() { printf '\n%s== %s ==%s\n' "$BLU" "$1" "$RST"; }
ok()   { printf '  %s[OK]%s %s\n' "$GRN" "$RST" "$1"; }
warn() { printf '  %s[WARN]%s %s\n' "$YEL" "$RST" "$1"; }
fail() { printf '  %s[FAIL]%s %s\n' "$RED" "$RST" "$1"; }
info() { printf '  %s\n' "$1"; }

need_root() { [[ $EUID -eq 0 ]] || { echo "Run with sudo: sudo $0 $MODE" >&2; exit 1; }; }
listening() { ss -Hltn "( sport = :$1 )" 2>/dev/null | grep -q .; }

# ---- scored-service health, same idea as dropflag.sh --------------------------
probe() {
  local line=""
  { exec 3<>"/dev/tcp/127.0.0.1/$1"; } 2>/dev/null || return 1
  read -r -t 5 line <&3; exec 3>&- 3<&-
  [[ $line == "$2"* ]]
}
check_port() {
  case $1 in
    22) probe 22 "SSH-" ;; 21|25|587) probe "$1" "220" ;;
    110) probe 110 "+OK" ;; 143) probe 143 "* OK" ;;
    *) listening "$1" ;;
  esac
}
BASE=()
record_base() { local p; BASE=(); for p in "${SCORED_TCP[@]}"; do check_port "$p" && BASE+=("$p"); done; }
healthy() {
  local p bad=0 code
  for p in "${BASE[@]}"; do check_port "$p" || { fail "port $p stopped answering"; bad=1; }; done
  # Ports 80/443 answering isn't enough: the webmail page itself must load.
  for p in 443 80; do
    in_base "$p" || continue
    if [[ $p == 443 ]]; then code=$(curl -sk -o /dev/null -m 10 -w '%{http_code}' https://localhost/)
    else code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' http://localhost/); fi
    [[ $code =~ ^[23] ]] || { fail "web page on $p returned $code"; bad=1; }
  done
  return $bad
}
in_base() { local x; for x in "${BASE[@]}"; do [[ $x == "$1" ]] && return 0; done; return 1; }

wait_engine() {
  # Suricata takes 30-90 s to load tens of thousands of rules.
  local i
  for i in $(seq 1 120); do
    grep -q 'engine started' "$LOG/suricata.log" 2>/dev/null && return 0
    systemctl is-active --quiet suricata || [[ $i -lt 10 ]] || return 1
    sleep 1
  done
  return 1
}

restart_fresh() {
  # Clear the old log first so wait_engine sees this start, not the last one.
  : > "$LOG/suricata.log" 2>/dev/null
  systemctl restart suricata
}

# ---- install --------------------------------------------------------------------
do_install() {
  need_root
  step "Checks"
  local avail iface net
  avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
  if ((avail < 1500)); then
    warn "Only ${avail} MB of memory available. Suricata with the full rule set uses about 1 GB."
    read -r -p "  >> Continue anyway? [y/N] " a < /dev/tty; [[ $a =~ ^[Yy] ]] || exit 1
  else
    ok "${avail} MB of memory available"
  fi
  iface=$(ip -o route show default | awk '{print $5; exit}')
  [[ -n $iface ]] || { fail "No default route; can't tell which interface to watch."; exit 1; }
  net=$(ip -o -4 route show dev "$iface" scope link | awk '{print $1; exit}')
  [[ -n $net ]] || net=$(ip -o -4 addr show dev "$iface" | awk '{print $4; exit}')
  ok "Interface $iface, network $net"

  step "Install"
  if ! command -v suricata >/dev/null || ! command -v suricata-update >/dev/null; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends suricata suricata-update jq >/dev/null \
      || { fail "apt install failed (no internet, or another apt is running: try again in a minute)"; exit 1; }
  fi
  ok "$(suricata -V 2>/dev/null | head -1)"
  [[ -f $CONF.orig ]] || cp -a "$CONF" "$CONF.orig"
  info "Original config kept as $CONF.orig"

  step "Configure"
  # 1. HOME_NET = this box's subnet. The default includes all of 172.16.0.0/12,
  #    which would count the competition's public range as "inside".
  sed -i -E "s|^(\s*HOME_NET:).*|\1 \"[$net]\"|" "$CONF"
  # 2. EXTERNAL_NET = any, so rules fire whatever the source (lateral movement too).
  sed -i -E 's|^(\s*EXTERNAL_NET:).*|\1 "any"|' "$CONF"
  # 3. Watch the real interface; the package assumes eth0.
  sed -i -E "s/(- interface:) eth0$/\1 $iface/" "$CONF"
  # 4. Look for rules where suricata-update writes them. Out of the box these
  #    don't match and Suricata starts with zero rules.
  sed -i -E 's|^default-rule-path: .*|default-rule-path: /var/lib/suricata/rules|' "$CONF"
  # 5. Add our local rules file to the list (once).
  grep -q "$LOCAL_RULES" "$CONF" || sed -i -E "s|^  - suricata.rules$|  - suricata.rules\n  - $LOCAL_RULES|" "$CONF"
  # 6. IPS safety: if Suricata falls behind, let packets through instead of dropping.
  sed -i -E 's/^#  mode: accept/  mode: accept/; s/^#  fail-open: yes/  fail-open: yes/' "$CONF"
  ok "HOME_NET [$net], EXTERNAL_NET any, interface $iface, rule path fixed, fail-open on"
  grep -nE '^\s*(HOME_NET|EXTERNAL_NET):|^default-rule-path|local.rules|^\s*fail-open' "$CONF" | sed 's/^/      /'

  step "Rules"
  mkdir -p /var/lib/suricata/rules /etc/suricata/rules
  if suricata-update -q >/dev/null 2>&1; then
    ok "Emerging Threats Open rules: $(grep -c '^alert' /var/lib/suricata/rules/suricata.rules) alert rules"
  else
    warn "Couldn't download Emerging Threats rules (no internet?). Running with local rules only."
    touch /var/lib/suricata/rules/suricata.rules
  fi
  write_local_rules

  step "Test the configuration"
  local t
  t=$(suricata -T -c "$CONF" -v 2>&1)
  if grep -q 'successfully loaded' <<< "$t"; then
    ok "$(grep -oE '[0-9]+ rules successfully loaded, [0-9]+ rules failed' <<< "$t" | tail -1)"
  else
    fail "Config test failed:"; grep -iE 'error|err:' <<< "$t" | head -5 | sed 's/^/      /'
    info "Restore the original with: sudo cp $CONF.orig $CONF"; exit 1
  fi

  step "Start in IDS mode (watch and alert, never blocks)"
  rm -f "$DROPIN"; systemctl daemon-reload
  systemctl enable suricata >/dev/null 2>&1
  restart_fresh
  info "Loading rules, this takes up to a minute..."
  if wait_engine; then ok "Suricata is running in IDS mode"; else fail "Suricata didn't start. Check: sudo tail -n 30 $LOG/suricata.log"; exit 1; fi

  step "Self-test"
  curl -s -m 10 http://testmynids.org/uid/index.html >/dev/null 2>&1
  sleep 3
  if grep -q '2100498' "$LOG/fast.log" 2>/dev/null; then
    ok "Detection works: test alert 'GPL ATTACK_RESPONSE id check returned root' fired"
  else
    warn "No test alert. Normal if the box can't reach testmynids.org, or if the ET rules didn't download."
  fi
  echo
  info "Alerts:      sudo $0 alerts"
  info "IPS mode:    sudo $0 ips-on   (only rules you add with 'block' drop traffic)"
  info "If you use baseline.sh, run 'sudo ./baseline.sh save' now: Suricata is a new running service."
}

write_local_rules() {
  # One rule per service that's actually listening. Rules only see plaintext
  # ports; encrypted ones (993, 995, 465, 443) can't be inspected.
  local sid
  [[ -f $LOCAL_RULES ]] && cp -a "$LOCAL_RULES" "$LOCAL_RULES.bak"
  # Keep any block rules from a previous run.
  local blocks=""
  [[ -f $LOCAL_RULES ]] && blocks=$(grep -E '^drop ip .*LOCAL block' "$LOCAL_RULES")
  {
    echo "# Generated by suricata-setup.sh $(date '+%F %T') from the services listening on this box."
    echo "# Each rule needs a unique sid. Yours: 1000100-1000999. Blocks: 1001000+."
    if listening 110; then
      echo 'alert tcp $HOME_NET 110 -> any any (msg:"LOCAL POP3 repeated login failures"; flow:from_server,established; content:"-ERR"; depth:4; content:"Authentication failed"; nocase; distance:0; threshold:type both, track by_dst, count 5, seconds 60; classtype:attempted-user; sid:1000001; rev:1;)'
    fi
    if listening 143; then
      echo 'alert tcp $HOME_NET 143 -> any any (msg:"LOCAL IMAP repeated login failures"; flow:from_server,established; content:"AUTHENTICATIONFAILED"; nocase; threshold:type both, track by_dst, count 5, seconds 60; classtype:attempted-user; sid:1000002; rev:1;)'
    fi
    if listening 25 || listening 587; then
      echo 'alert tcp $HOME_NET [25,587] -> any any (msg:"LOCAL SMTP AUTH repeated failures"; flow:from_server,established; content:"535"; depth:3; threshold:type both, track by_dst, count 5, seconds 60; classtype:attempted-user; sid:1000003; rev:1;)'
      echo 'alert tcp any any -> $HOME_NET 25 (msg:"LOCAL SMTP VRFY or EXPN (user enumeration)"; flow:to_server,established; pcre:"/^(VRFY|EXPN)\s/mi"; classtype:attempted-recon; sid:1000005; rev:1;)'
    fi
    if listening 80; then
      echo 'alert http any any -> $HOME_NET any (msg:"LOCAL possible webshell command in URL"; flow:to_server,established; http.uri; pcre:"/[?&](cmd|exec|command|shell)=/i"; classtype:web-application-attack; sid:1000004; rev:1;)'
      echo 'alert http any any -> $HOME_NET any (msg:"LOCAL request for a PHP file in a writable folder"; flow:to_server,established; http.uri; pcre:"/\/(temp|logs|uploads?|tmp)\/[^?]*\.ph(p[0-9]?|tml|ar)/i"; classtype:web-application-attack; sid:1000006; rev:1;)'
    fi
    echo 'alert tcp $HOME_NET any -> any any (msg:"LOCAL shell output leaving the server (id command)"; flow:established; content:"uid="; content:"gid="; distance:0; within:40; classtype:successful-admin; sid:1000007; rev:1;)'
    [[ -n $blocks ]] && echo "$blocks"
  } > "$LOCAL_RULES"
  sid=$(grep -c 'sid:' "$LOCAL_RULES")
  ok "$sid local rules written to $LOCAL_RULES for the services present:"
  grep -oE 'msg:"[^"]+"' "$LOCAL_RULES" | sed 's/msg:/      /'
}

# ---- IPS on/off -------------------------------------------------------------
do_ips_on() {
  need_root
  command -v suricata >/dev/null || { fail "Run '$0 install' first."; exit 1; }
  step "Before"
  record_base
  if ((${#BASE[@]})); then ok "Answering now, re-checked after the switch: ${BASE[*]}"; else warn "No scored ports answer locally."; fi

  step "Switch to IPS"
  mkdir -p "$DROPIN_DIR"
  cat > "$DROPIN" <<'EOF'
# Written by suricata-setup.sh: IPS mode. Remove with: suricata-setup.sh ips-off
# Traffic is queued in the mangle table, before ufw. --queue-bypass and
# fail-open mean a stopped, crashed or slow Suricata never blocks traffic,
# and ufw still filters everything Suricata passes. Loopback is skipped.
[Service]
ExecStart=
ExecStart=/usr/bin/suricata -D -q 0 -c /etc/suricata/suricata.yaml --pidfile /run/suricata.pid
ExecStartPost=/bin/sh -c 'iptables -t mangle -C INPUT ! -i lo -j NFQUEUE --queue-num 0 --queue-bypass 2>/dev/null || iptables -t mangle -I INPUT ! -i lo -j NFQUEUE --queue-num 0 --queue-bypass'
ExecStartPost=/bin/sh -c 'iptables -t mangle -C OUTPUT ! -o lo -j NFQUEUE --queue-num 0 --queue-bypass 2>/dev/null || iptables -t mangle -I OUTPUT ! -o lo -j NFQUEUE --queue-num 0 --queue-bypass'
ExecStopPost=-/usr/sbin/iptables -t mangle -D INPUT ! -i lo -j NFQUEUE --queue-num 0 --queue-bypass
ExecStopPost=-/usr/sbin/iptables -t mangle -D OUTPUT ! -o lo -j NFQUEUE --queue-num 0 --queue-bypass
EOF
  systemctl stop suricata
  systemctl daemon-reload
  : > "$LOG/suricata.log"
  systemctl start suricata
  info "Loading rules, this takes up to a minute..."
  if ! wait_engine; then
    fail "Suricata didn't start in IPS mode. Switching back to IDS."
    do_ips_off quiet; exit 1
  fi
  sleep 3
  if grep -qiE 'NFQ running|fail-open' "$LOG/suricata.log"; then ok "Queue bound, fail-open on"; else warn "Couldn't confirm the queue in the log"; fi
  iptables -t mangle -S | grep NFQUEUE | sed 's/^/      /'

  step "After: are scored services still answering?"
  if healthy; then
    ok "All scored services answer. IPS is on."
    info "Watch Quotient for the next round. If anything goes red: sudo $0 ips-off"
  else
    fail "Something stopped answering. Switching back to IDS."
    do_ips_off quiet
    record_base >/dev/null
  fi
}

do_ips_off() {
  need_root
  # Stop first so the override's own cleanup removes the queue rules.
  systemctl stop suricata
  rm -f "$DROPIN"
  systemctl daemon-reload
  # Belt and braces: remove any queue rules left behind.
  while iptables -t mangle -D INPUT ! -i lo -j NFQUEUE --queue-num 0 --queue-bypass 2>/dev/null; do :; done
  while iptables -t mangle -D OUTPUT ! -o lo -j NFQUEUE --queue-num 0 --queue-bypass 2>/dev/null; do :; done
  restart_fresh
  [[ ${1:-} == quiet ]] || { info "Loading rules..."; wait_engine && ok "Back in IDS mode (alerts only, nothing blocked)"; }
  [[ ${1:-} == quiet ]] && ok "Back in IDS mode"
}

# ---- block / unblock ----------------------------------------------------------
valid_ip() { [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ ]]; }

do_block() {
  need_root
  local ip=$1 sid
  valid_ip "$ip" || { echo "Usage: sudo $0 block 1.2.3.4"; exit 1; }
  # The scoring engine logs in from rotating addresses in 10.0.0.0/8 and the
  # three documentation ranges (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24).
  if [[ $ip == 10.* || $ip == 192.0.2.* || $ip == 198.51.100.* || $ip == 203.0.113.* ]]; then
    warn "$ip is in a range the scoring engine logs in from (10.x, 192.0.2.x, 198.51.100.x, 203.0.113.x)."
    warn "Blocking it can fail scoring checks. Only block it if you've seen it attack: a long session,"
    warn "commands run, or a burst of failed logins, not just a 0-second login."
    read -r -p "  >> Block $ip anyway? [y/N] " a < /dev/tty; [[ $a =~ ^[Yy] ]] || exit 0
  fi
  if [[ $ip == 172.17.0.* ]]; then
    warn "$ip is your own Kali VM's network."
    read -r -p "  >> Block it anyway? [y/N] " a < /dev/tty; [[ $a =~ ^[Yy] ]] || exit 0
  fi
  if [[ $ip == 172.20.* ]]; then
    warn "$ip is on your own team network (another of your servers?)."
    read -r -p "  >> Block it anyway? [y/N] " a < /dev/tty; [[ $a =~ ^[Yy] ]] || exit 0
  fi
  grep -q "LOCAL block $ip\"" "$LOCAL_RULES" && { ok "$ip is already blocked"; return; }
  sid=$(( $(grep -oE 'sid:100[1-9][0-9]{3}' "$LOCAL_RULES" | cut -d: -f2 | sort -n | tail -1) + 1 ))
  ((sid > 1001000)) || sid=1001000
  echo "drop ip $ip any -> any any (msg:\"LOCAL block $ip\"; sid:$sid; rev:1;)" >> "$LOCAL_RULES"
  echo "drop ip any any -> $ip any (msg:\"LOCAL block $ip\"; sid:$((sid + 1)); rev:1;)" >> "$LOCAL_RULES"
  reload_rules
  ok "Blocking $ip in both directions (sids $sid, $((sid + 1)))"
  [[ -f $DROPIN ]] || warn "IPS mode is off, so this only ALERTS. Turn on blocking with: sudo $0 ips-on"
  info "Systems rule 9 allows blocking a specific attacker. Never block to allow only the scorer."
  info "Write it down: time, IP, why (the alert or log line that showed the attack)."
}

do_unblock() {
  need_root
  local ip=$1
  valid_ip "$ip" || { echo "Usage: sudo $0 unblock 1.2.3.4"; exit 1; }
  sed -i "/LOCAL block ${ip//\//\\/}\"/d" "$LOCAL_RULES"
  reload_rules
  ok "Removed the block on $ip"
}

reload_rules() {
  # Live reload keeps traffic flowing; fall back to a restart if it fails.
  if suricata -T -c "$CONF" >/dev/null 2>&1; then
    systemctl reload suricata 2>/dev/null || restart_fresh
  else
    fail "The rules don't load. Check $LOCAL_RULES (a backup is in $LOCAL_RULES.bak)."; exit 1
  fi
}

# ---- alerts / status ------------------------------------------------------------
do_alerts() {
  need_root
  if command -v jq >/dev/null && [[ -s $LOG/eve.json ]]; then
    jq -r 'select(.event_type=="alert") | [.timestamp[0:19], (.alert.action|ascii_upcase), .src_ip, "->", .dest_ip+":"+(.dest_port|tostring), .alert.signature] | join("  ")' "$LOG/eve.json" | tail -n 20
  else
    tail -n 20 "$LOG/fast.log"
  fi
}

do_status() {
  need_root
  local mode=IDS
  [[ -f $DROPIN ]] && mode=IPS
  echo "Mode:     $mode"
  echo "Service:  $(systemctl is-active suricata)"
  echo "Rules:    $(grep -oE '[0-9]+ rules successfully loaded, [0-9]+ rules failed' "$LOG/suricata.log" 2>/dev/null | tail -1)"
  echo "Queue:    $(iptables -t mangle -S 2>/dev/null | grep -c NFQUEUE) NFQUEUE rules (2 in IPS mode, 0 in IDS)"
  echo "Blocks:   $(grep -oE 'LOCAL block [0-9./]+' "$LOCAL_RULES" 2>/dev/null | sort -u | sed 's/LOCAL block //' | tr '\n' ' ')"
  echo "Memory:   $(ps -C suricata -o rss= | awk '{s+=$1} END {printf "%d MB", s/1024}') used by Suricata, $(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo) MB available"
  echo "Alerts:   $(wc -l < "$LOG/fast.log" 2>/dev/null) total in fast.log"
}

case $MODE in
  install) do_install ;;
  ips-on)  do_ips_on ;;
  ips-off) do_ips_off ;;
  block)   do_block "${2:-}" ;;
  unblock) do_unblock "${2:-}" ;;
  alerts)  do_alerts ;;
  status)  do_status ;;
  *) sed -n '2,31p' "$0"; exit 1 ;;
esac
