<?xml version='1.0' encoding='utf-8'?>
<form version="1.1">
  <label>CCDC | Debian Splunk Server</label>
  <description>Debian 12 / Splunk 10.0.2 at 172.20.240.20. Internal indexes do not depend on forwarded host naming.</description>
  <fieldset submitButton="false" autoRun="true">
    <input type="dropdown" token="selected_host" searchWhenChanged="true">
      <label>Select actual Splunk hostname for this VM</label>
      <choice value="*">All hosts (select your VM)</choice>
      <search>
        <query>index=* | stats count by host | fields host | sort host</query>
      </search>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time</label>
      <default>
        <earliest>-1h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Splunk Errors and Warnings</title>
      <table>
        <search>
          <query>index=_internal (log_level=ERROR OR log_level=WARN) | stats count by log_level,component | sort -count</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Splunk Administrative Audit</title>
      <table>
        <search>
          <query>index=_audit | table _time user action info _raw | sort -_time | head 100</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Forwarder Connectivity (internal metrics, when available)</title>
      <table>
        <search>
          <query>index=_internal (component=TcpInputProc OR component=Metrics) | stats count by host,component | sort -count</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Debian Syslog Events</title>
      <chart>
        <search>
          <query>index=* host="$selected_host$" (source="*/syslog" OR source="*/auth.log" OR source="*/messages") | timechart span=5m count by source</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
      </chart>
    </panel>
  </row>
</form>